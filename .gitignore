# build/run artifacts
__pycache__/
*.pyc
*.o
*_linux
*_macos
/tmp/

# never commit signing private keys (public key + signed manifests ARE committed)
*.key
*.seed
.DS_Store

# run artifacts of demo patterns
demo_logs/

# renderer writes its report into the CURRENT directory; the canonical copy lives in ~/aura-docs
AUDIT-REPORT.md
AUDIT-RESULTS.jsonl

# harvest_gate deployment symlinks — the tools live at ~/ai-lab/pattern-scoring/validator/ (STAGING)
# and are symlinked here to satisfy v10.1's LIB-hardcoded paths. Symlinks are machine-specific.
/chaos_scan.py
/chaos_report.json
/invariant_mine.py
/invariant_mine_report.json

# harvest_gate rolling backups from local deploys
harvest_gate.py.bak-*

# observation-mode harvest results — per-run outputs, not part of the signed library
.harvest/results/
.harvest/contradictions/

# SQLite test-artifact pollution guard (2026-09-08)
the quick brown fox
*-journal
